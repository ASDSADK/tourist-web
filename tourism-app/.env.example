# Copy to .env. Replace the token before starting the server.
INGEST_TOKEN=replace-with-a-local-demo-token
PORT=3001
# https URL generated by the actual booking mini program; leave blank until available.
BOOKING_URL=
# Optional PostgreSQL connection. Without it, local demo snapshots use data/state.json.
DATABASE_URL=
# Optional relative directory for isolated preview/QA history; default is data/.
DATA_DIRECTORY=
