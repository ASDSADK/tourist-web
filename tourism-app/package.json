{
  "name": "tourism-ue-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "simulate": "node --env-file-if-exists=.env server/simulate.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:pages": "vue-tsc --noEmit && node scripts/build-pages.mjs",
    "test": "node --experimental-strip-types --test server/core.test.mjs server/static.test.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
